<script>
// =====================================================
// BLOCK 104 START - JavaScript Logic
// Purpose: Move management layer to top and apply requested text cleanup.
// =====================================================
(function(){
"use strict";
function cv104ApplyDashboardChangeover(){
    const app=document.getElementById("dashboardApp");
    const container=document.getElementById("dashboardSections");
    if(!app||!container||!app.classList.contains("claims-volume-layout-active"))return;
    const shell=container.querySelector(".claims-demo-shell");
    if(!shell)return;
    const eyebrow=shell.querySelector(".claims-demo-eyebrow");
    if(eyebrow)eyebrow.innerHTML="<span class='claims-demo-live-dot'></span>GHI Clams Volume";
    const title=shell.querySelector(".claims-demo-heading h2");
    if(title)title.remove();
    const description=shell.querySelector(".claims-demo-heading p");
    if(description)description.remove();
    const demoStatus=shell.querySelector(".claims-demo-status-chip");
    if(demoStatus)demoStatus.remove();
    const management=shell.querySelector(".claims-demo-management-panel");
    const kpis=shell.querySelector(".claims-demo-kpi-grid");
    if(management&&kpis&&management.parentElement!==shell)shell.insertBefore(management,kpis);
}
const previous=typeof renderDemoClaimsAnalytics==="function"?renderDemoClaimsAnalytics:null;
if(previous){
    renderDemoClaimsAnalytics=function(data){
        const result=previous.call(this,data);
        cv104ApplyDashboardChangeover();
        return result;
    };
    window.renderDemoClaimsAnalytics=renderDemoClaimsAnalytics;
}
setTimeout(cv104ApplyDashboardChangeover,100);
const target=document.getElementById("dashboardSections");
if(target){
    new MutationObserver(function(){
        const app=document.getElementById("dashboardApp");
        if(app&&app.classList.contains("claims-volume-layout-active"))cv104ApplyDashboardChangeover();
    }).observe(target,{childList:true,subtree:false});
}
})();
// =====================================================
// BLOCK 104 END - JavaScript Logic
// =====================================================
</script>

