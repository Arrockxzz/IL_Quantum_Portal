    function buildProfile(data) {
        var columns = [];
        var seen = {};
        data.slice(0,1000).forEach(function(row) {
            Object.keys(row || {}).forEach(function(k) {
                if (!seen[k]) { seen[k] = true; columns.push(k); }
            });
        });

        var numeric = [];
        var categories = {};

        columns.forEach(function(col) {
            var vals = data.map(function(r){return r ? r[col] : null;})
                .filter(function(v){return v != null && String(v).trim() !== "";});
            if (!vals.length) return;

            var nums = vals.map(numberValue).filter(function(v){return v !== null;});
            if (nums.length / vals.length >= .75) {
                numeric.push({
                    col: col,
                    avg: nums.reduce(function(a,b){return a+b;},0)/nums.length,
                    max: Math.max.apply(null,nums),
                    min: Math.min.apply(null,nums)
                });
            } else {
                var counts = {};
                vals.forEach(function(v){
                    var key = String(v).trim();
                    counts[key] = (counts[key] || 0) + 1;
                });
                categories[col] = Object.keys(counts).map(function(k){
                    return {label:k,count:counts[k]};
                }).sort(function(a,b){return b.count-a.count;}).slice(0,5);
            }
        });

        return {columns:columns,numeric:numeric,categories:categories};
