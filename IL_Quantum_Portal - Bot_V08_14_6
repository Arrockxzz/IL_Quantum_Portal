<script>
// =====================================================
// BLOCK 072 START - JavaScript Logic
// Purpose: Portal behavior and dashboard logic.
// =====================================================
function cvNumber(value){
if(value===undefined||value===null)return 0;

const s=String(value)
.replace(/,/g,"")
.replace(/₹/g,"")

.replace(/'/g,"")
.trim();

if(!s||s.toLowerCase()==="null"||s.toLowerCase()==="undefined")return 0;

const n=Number(s);
return isNaN(n)?0:n;
}

function cvFormatNumber(value,decimals){
const n=Number(value||0);

return n.toLocaleString("en-IN",{
minimumFractionDigits:decimals||0,
maximumFractionDigits:decimals||0
});
}

function cvPercent(part,total){
return total?(part/total)*100:0;
}

function cvFormatPercent(value){
return Number(value||0).toFixed(1)+"%";
}

function cvGetDate(value){
if(value===undefined||value===null||String(value).trim()==="")return null;

if(typeof parseDateValue==="function"){
const parsed=parseDateValue(value);
if(parsed&&!isNaN(parsed.getTime()))return parsed;
}

if(typeof value==="number"&&!isNaN(value)){
const excelEpoch=new Date(Date.UTC(1899,11,30));
const d=new Date(excelEpoch.getTime()+value*86400000);
return isNaN(d.getTime())?null:d;
}

const s=String(value).trim();
let d=new Date(s);

if(!isNaN(d.getTime()))return d;

const m=s.match(/^(\d{1,2})\d{1,2}\d{2,4}$/);

if(m){
let day=Number(m[1]);
let month=Number(m[2])-1;
let year=Number(m[3]);

if(year<100)year+=2000;

d=new Date(year,month,day);
if(!isNaN(d.getTime()))return d;
}

return null;
}

function cvMonthFromValue(value){
const d=cvGetDate(value);
if(!d)return "Unknown";

return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0");
}

function cvDistinctCount(data,col){
if(!col)return 0;

const set=new Set();

(data||[]).forEach(row=>{
const value=cvRowText(row,col,"");
if(value)set.add(value);
});

return set.size;
}

function cvCountBy(data,col,topN,sortByLabel){
const map={};

(data||[]).forEach(row=>{
const label=cvRowText(row,col,"Unknown");
map[label]=(map[label]||0)+1;
});

let arr=Object.keys(map).map(label=>({
label:label,
value:map[label]
}));

if(sortByLabel){
arr.sort((a,b)=>String(a.label).localeCompare(String(b.label)));
}else{
arr.sort((a,b)=>b.value-a.value);
}

if(topN)arr=arr.slice(0,topN);

return arr;
}

function cvCountByMonth(data,col){
if(!col)return [];

const map={};

(data||[]).forEach(row=>{
const label=cvMonthFromValue(row[col]);
map[label]=(map[label]||0)+1;
});

return Object.keys(map)
.map(label=>({label:label,value:map[label]}))
.filter(x=>x.label!=="Unknown")
.sort((a,b)=>String(a.label).localeCompare(String(b.label)));
}

function cvFamilySizeDistribution(data,policyCol,employeeCol){
const familyMap={};

(data||[]).forEach(row=>{
const policy=cvRowText(row,policyCol,"");
const employee=cvRowText(row,employeeCol,"");

if(!employee)return;

const key=policy+"||"+employee;
familyMap[key]=(familyMap[key]||0)+1;
});

const dist={};

Object.keys(familyMap).forEach(key=>{
const size=familyMap[key];
dist[size]=(dist[size]||0)+1;
});

return Object.keys(dist)
.map(size=>({label:size+" Life",value:dist[size]}))
.sort((a,b)=>Number(a.label.split(" ")[0])-Number(b.label.split(" ")[0]));
}

function cvMissingPercent(data,col){
if(!col||!data||!data.length)return 0;

let missing=0;

data.forEach(row=>{
const value=row[col];

if(value===undefined||value===null||String(value).trim()===""||String(value).trim().toLowerCase()==="null"){
missing++;
}
});

return cvPercent(missing,data.length);
}

