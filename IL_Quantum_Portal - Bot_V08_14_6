<script>
// =====================================================
// BLOCK 107 START - JavaScript Logic
// Purpose: Create the top-bar quantum once outside dashboard render containers.
// =====================================================
(function(){
"use strict";

function cv107DashboardIsVisible(){
    const app=document.getElementById("dashboardApp");
    if(!app)return false;
    const style=window.getComputedStyle(app);
    return style.display!=="none" && style.visibility!=="hidden";
}

function cv107CreatePermanentQuantum(){
    let quantum=document.getElementById("cv107PermanentQuantum");
    if(!quantum){
        quantum=document.createElement("div");
        quantum.id="cv107PermanentQuantum";
        quantum.setAttribute("aria-hidden","true");
        quantum.innerHTML=
            "<span class='cv107-ring cv107-ring-one'></span>"+
            "<span class='cv107-ring cv107-ring-two'></span>"+
            "<span class='cv107-core'></span>"+
            "<span class='cv107-particle cv107-particle-one'></span>"+
            "<span class='cv107-particle cv107-particle-two'></span>"+
            "<span class='cv107-particle cv107-particle-three'></span>";
        document.body.appendChild(quantum);
    }
    return quantum;
}

function cv107SyncPermanentQuantum(){
    const quantum=cv107CreatePermanentQuantum();
    quantum.classList.toggle("cv107-visible",cv107DashboardIsVisible());
    quantum.querySelectorAll("*").forEach(function(node){
        node.style.animationPlayState="running";
    });
}

/* Create immediately and keep visibility synced with dashboard navigation. */
cv107SyncPermanentQuantum();
setTimeout(cv107SyncPermanentQuantum,50);
setTimeout(cv107SyncPermanentQuantum,300);

const app=document.getElementById("dashboardApp");
if(app){
    new MutationObserver(cv107SyncPermanentQuantum).observe(app,{
        attributes:true,
        attributeFilter:["class","style"]
    });
}

/* Live/Demo and module actions can update state asynchronously. */
document.addEventListener("click",function(){
    setTimeout(cv107SyncPermanentQuantum,0);
    setTimeout(cv107SyncPermanentQuantum,120);
},true);

window.addEventListener("pageshow",cv107SyncPermanentQuantum);
window.addEventListener("focus",cv107SyncPermanentQuantum);
document.addEventListener("visibilitychange",function(){
    if(!document.hidden)cv107SyncPermanentQuantum();
});

/* Public helper for any future dashboard render hook. */
window.cv107SyncPermanentQuantum=cv107SyncPermanentQuantum;

})();
// =====================================================
// BLOCK 107 END - JavaScript Logic
// =====================================================
</script>

