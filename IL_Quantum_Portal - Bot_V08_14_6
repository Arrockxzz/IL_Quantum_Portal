(function(){
"use strict";

function cv103GetCurrentModuleName(){
    if(typeof cvDecodeModuleName==="function"){
        return cvDecodeModuleName(activeDashboardModule);
    }
    return String(activeDashboardModule||"")
        .replace(/&gt;/g,">")
        .replace(/&#62;/g,">")
        .replace(/\s*>\s*/g," > ")
        .trim();
}

function cv103IsClaimsVolumeModule(){
    return cv103GetCurrentModuleName()==="Health Claim > Claims Volume";
}

function cv103GetLiveData(){
    if(Array.isArray(filteredData)&&filteredData.length){
        return filteredData;
    }
    if(typeof getFilteredData==="function"){
        const currentFilteredData=getFilteredData();
        if(Array.isArray(currentFilteredData)&&currentFilteredData.length){
            return currentFilteredData;
        }
    }
    return Array.isArray(combinedData)?combinedData:[];
}

function cv103ApplyClaimsVolumePageState(){
    const dashboardApp=document.getElementById("dashboardApp");
    if(dashboardApp)dashboardApp.classList.add("claims-volume-layout-active");

    const customBuilder=document.getElementById("moduleCustomBuilderWrap");
    if(customBuilder)customBuilder.style.display="none";

    const container=document.getElementById("dashboardSections");
    if(container){
        container.style.width="100%";
        container.style.maxWidth="none";
        container.style.margin="0";
        container.style.padding="0";
        container.style.display="block";
    }
    return container;
}

function cv103RemoveClaimsVolumePageState(){
    const dashboardApp=document.getElementById("dashboardApp");
    if(dashboardApp)dashboardApp.classList.remove("claims-volume-layout-active");
}

function cv103RenderClaimsVolumeWithDemoLayout(){
    const container=cv103ApplyClaimsVolumePageState();
    if(!container)return;

    const data=cv103GetLiveData();
    if(typeof renderDemoClaimsAnalytics!=="function"){
        container.innerHTML="<div class='claims-demo-shell'><div class='claims-demo-card claims-demo-wide'><div class='claims-demo-card-head'><div><div class='claims-demo-card-title'>Claims Volume</div><div class='claims-demo-card-sub'>Demo layout renderer is unavailable.</div></div></div></div></div>";
        return;
    }

    renderDemoClaimsAnalytics(data);

    const eyebrow=container.querySelector(".claims-demo-eyebrow");
    if(eyebrow)eyebrow.innerHTML="<span class='claims-demo-live-dot'></span>LIVE CLAIMS VOLUME INTELLIGENCE";

    const heading=container.querySelector(".claims-demo-heading h2");
    if(heading)heading.textContent="Claims Volume Command Center";

    const subtitle=container.querySelector(".claims-demo-heading p");
    if(subtitle)subtitle.textContent="Live claim analytics using the same chart layout, KPI design and visual structure as Demo mode.";

    const statusChip=container.querySelector(".claims-demo-status-chip");
    if(statusChip)statusChip.textContent="LIVE DATA · "+Number(data.length||0).toLocaleString("en-IN")+" RECORDS";
}

