    function numberValue(v) {
        if (typeof v === "number" && isFinite(v)) return v;
        if (v == null || String(v).trim() === "") return null;
        var n = Number(String(v).replace(/,/g,"").replace(/₹/g,"").replace(/%/g,"").trim());
