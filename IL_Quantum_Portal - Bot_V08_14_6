function buildTatSummary(sec,data){
const inwardCol=getFirstAvailableColumn(["inward_date","Inward Date"]);
const paymentCol=getFirstAvailableColumn(["payment_date","Payment Date"]);
const doaCol=getFirstAvailableColumn(["doa","DOA"]);
const dodCol=getFirstAvailableColumn(["dod","DOD"]);

const map={};

data.forEach(row=>{
const label=getMonthBucket(row);
if(!map[label])map[label]=initAgg(label);

addAggRow(map[label],row);

const tat=daysBetween(getColumnValue(row,inwardCol,""),getColumnValue(row,paymentCol,""));
const los=daysBetween(getColumnValue(row,doaCol,""),getColumnValue(row,dodCol,""));

if(tat!==null)map[label].tatValues.push(tat);
if(los!==null)map[label].losValues.push(los);
});

let groups=Object.values(map);
groups.sort((a,b)=>monthSortValue(a.label)-monthSortValue(b.label));
groups=groups.slice(0,CONFIG.DEFAULT_TOP_N);

const rows=groups.map(g=>[
g.label,
formatNumber(aggClaimCount(g)),
average(g.tatValues).toFixed(1),
median(g.tatValues).toFixed(1),
average(g.losValues).toFixed(1),
formatCurrency(g.approved),
formatCurrency(g.paid)
]);

return{
headers:sec.tableColumns,
rows,
raw:groups.map(g=>({label:g.label,count:aggClaimCount(g),amount:average(g.tatValues),approved:g.approved,paid:g.paid})),
chartLabels:groups.map(g=>g.label),
chartValues:groups.map(g=>Number(average(g.tatValues).toFixed(1)))
};
}

function buildUtilizationSummary(sec,data){
const dimension=getFirstAvailableColumn(sec.dimensionAliases);

if(!dimension){
return{headers:["Message"],rows:[["Policy / group column not detected"]],chartLabels:["No Data"],chartValues:[0],raw:[]};
}

let groups=groupDataByDimension(data,dimension);
groups.sort((a,b)=>b.approved-a.approved);
groups=groups.slice(0,CONFIG.DEFAULT_TOP_N);

const rows=groups.map(g=>{
const si=maxValue(g.sumInsuredValues);
const bal=average(g.balanceSiValues);
const util=pct(g.approved,si);

return[
g.label,
formatNumber(aggClaimCount(g)),
formatCurrency(si),
formatCurrency(g.approved),
formatCurrency(bal),
formatPct(util),
formatCurrency(aggACS(g))
];
});

return{
headers:sec.tableColumns,
rows,
raw:groups.map(g=>{
const si=maxValue(g.sumInsuredValues);
return{label:g.label,count:aggClaimCount(g),amount:pct(g.approved,si),approved:g.approved,acs:aggACS(g)};
