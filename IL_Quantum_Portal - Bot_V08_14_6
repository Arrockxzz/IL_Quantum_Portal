function getFirstAvailableColumn(aliases){
return findColumn(aliases||[]);
}

function getColumnValue(row,col,fallback=""){
if(!col)return fallback;
const v=row[col];
if(v===undefined||v===null||String(v).trim()==="")return fallback;
return v;
}

function getTextValue(row,col,fallback="Unknown"){
const v=getColumnValue(row,col,fallback);
return String(v||fallback).trim()||fallback;
}

function getAmountColumnValue(row,aliases){
const col=getFirstAvailableColumn(aliases);
return col?toNumber(row[col]):0;
}

function getClaimKey(row){
const claimCol=getFirstAvailableColumn(["claim_number","Claim Number","claim_no","claim_id"]);
const key=claimCol?String(row[claimCol]||"").trim():"";
return key || String(row.__fileId||"file")+"_"+String(row.__fileName||"row")+"_"+String(row.__sheetName||"sheet")+"_"+String(row.__monthYear||"month")+"_"+String(Math.random()).slice(2);
}

function initAgg(label){
return{
label:label||"Unknown",
rows:[],
claimKeys:new Set(),
claimed:0,
approved:0,
paid:0,
outstanding:0,
disallowed:0,
copayment:0,
deduction:0,
sumInsuredValues:[],
balanceSiValues:[],
cityValues:[],
stateValues:[],
networkValues:[],
tatValues:[],
losValues:[]
};
}

function addAggRow(agg,row){
agg.rows.push(row);
agg.claimKeys.add(getClaimKey(row));

const claimed=getAmountColumnValue(row,["claimed_amount","Claimed Amount","claim_amount","amount_claimed"]);
const approved=getAmountColumnValue(row,["net_sanct_amt","Net Sanct Amt","net_sanctioned_amount","approved_amount","sanctioned_amount"]);
const paid=getAmountColumnValue(row,["payment_amount","Payment Amount","paid_amount"]);
const outstanding=getAmountColumnValue(row,["claim_r_os_amt","Claim R OS Amt","outstanding_amount","os_amount"]);
const disallowed=getAmountColumnValue(row,["disallowed_amount","Disallowed Amount","disallowance_amount"]);
const copayment=getAmountColumnValue(row,["copayment_amt","Copayment Amt","copayment_amount"]);
const sumInsured=getAmountColumnValue(row,["sum_insured","Sum Insured","si"]);
const balanceSi=getAmountColumnValue(row,["bal_sum_insured","Bal Sum Insured","balance_sum_insured","balance_si"]);

agg.claimed+=claimed;
agg.approved+=approved;
agg.paid+=paid;
agg.outstanding+=outstanding;
agg.disallowed+=disallowed;
agg.copayment+=copayment;
agg.deduction+=(disallowed+copayment);

if(sumInsured>0)agg.sumInsuredValues.push(sumInsured);
if(balanceSi>=0)agg.balanceSiValues.push(balanceSi);
}

function aggClaimCount(agg){
return agg.claimKeys&&agg.claimKeys.size ? agg.claimKeys.size : agg.rows.length;
}

function aggACS(agg){
const count=aggClaimCount(agg);
return count?agg.approved/count:0;
}

function pct(part,total){
return total?(part/total)*100:0;
}

function formatPct(n){
return (Number(n||0)).toFixed(1)+"%";
}

function average(arr){
if(!arr||!arr.length)return 0;
const nums=arr.map(Number).filter(n=>!isNaN(n));
if(!nums.length)return 0;
return nums.reduce((a,b)=>a+b,0)/nums.length;
}

function median(arr){
if(!arr||!arr.length)return 0;
const nums=arr.map(Number).filter(n=>!isNaN(n)).sort((a,b)=>a-b);
if(!nums.length)return 0;
const mid=Math.floor(nums.length/2);
return nums.length%2 ? nums[mid] : (nums[mid-1]+nums[mid])/2;
}

function maxValue(arr){
if(!arr||!arr.length)return 0;
const nums=arr.map(Number).filter(n=>!isNaN(n));
if(!nums.length)return 0;
return Math.max(...nums);
}

function modeValue(values,fallback=""){
const m={};
(values||[]).forEach(v=>{
const s=String(v||"").trim();
if(!s)return;
m[s]=(m[s]||0)+1;
});
const keys=Object.keys(m);
if(!keys.length)return fallback;
keys.sort((a,b)=>m[b]-m[a]);
return keys[0];
}

function parseDateValue(v){
if(v===undefined||v===null||String(v).trim()==="")return null;

if(typeof v==="number"&&!isNaN(v)){
const excelEpoch=new Date(Date.UTC(1899,11,30));
const d=new Date(excelEpoch.getTime()+v*86400000);
return isNaN(d.getTime())?null:d;
}

const s=String(v).trim();
if(!s)return null;

const first=s.split(/[|,;]/)[0].trim();

let d=new Date(first);
if(!isNaN(d.getTime()))return d;

/* dd/mm/yyyy or dd-mm-yyyy */
const m=first.match(/^(\d{1,2})\d{1,2}\d{2,4}$/);
if(m){
let day=Number(m[1]);
let month=Number(m[2])-1;
let year=Number(m[3]);
if(year<100)year+=2000;
d=new Date(year,month,day);
if(!isNaN(d.getTime()))return d;
}

return null;
}

function daysBetween(start,end){
const s=parseDateValue(start);
const e=parseDateValue(end);
if(!s||!e)return null;
const diff=Math.round((e.getTime()-s.getTime())/86400000);
return isNaN(diff)||diff<0?null:diff;
}

function formatMonthYearFromDate(d){
if(!d||isNaN(d.getTime()))return "Unknown";
const months=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
return months[d.getMonth()]+"-"+d.getFullYear();
}

function getMonthBucket(row){
if(row.__monthYear&&String(row.__monthYear).trim()){
return String(row.__monthYear).trim();
}

const monthCol=getFirstAvailableColumn(["month_year","MonthYear","month"]);
const existing=getTextValue(row,monthCol,"");
if(existing&&existing!=="Unknown")return existing;

const payCol=getFirstAvailableColumn(["payment_date","Payment Date"]);
const inwardCol=getFirstAvailableColumn(["inward_date","Inward Date"]);
const doaCol=getFirstAvailableColumn(["doa","DOA"]);

return formatMonthYearFromDate(
parseDateValue(getColumnValue(row,payCol,"")) ||
parseDateValue(getColumnValue(row,inwardCol,"")) ||
parseDateValue(getColumnValue(row,doaCol,""))
);
}

function monthSortValue(label){
const s=String(label||"");
const months={jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11};
const m=s.match(/^([A-Za-z]{3})[-\s\/]?(\d{2,4})$/);
if(!m)return 999999;
let y=Number(m[2]);
if(y<100)y+=2000;
return y*12+(months[m[1].toLowerCase()]??0);
}

function groupDataByDimension(data,dimensionCol){
const map={};

data.forEach(row=>{
const label=getTextValue(row,dimensionCol,"Unknown");
if(!map[label])map[label]=initAgg(label);
addAggRow(map[label],row);
});

return Object.values(map);
}

function buildAmountSummary(sec,data){
const dimension=getFirstAvailableColumn(sec.dimensionAliases);

if(!dimension){
return{headers:["Message"],rows:[["Required dimension column not detected"]],chartLabels:["No Data"],chartValues:[0],raw:[]};
}

let groups=groupDataByDimension(data,dimension);
const totalApproved=groups.reduce((a,g)=>a+g.approved,0);

groups.sort((a,b)=>b.approved-a.approved);
groups=groups.slice(0,CONFIG.DEFAULT_TOP_N);

const rows=groups.map(g=>{
const base=[
g.label,
formatNumber(aggClaimCount(g)),
formatCurrency(g.claimed),
formatCurrency(g.approved),
formatCurrency(g.paid)
];

if(sec.id==="claimStatus"){
return[
...base,
formatCurrency(g.outstanding),
formatCurrency(g.deduction),
formatCurrency(aggACS(g)),
formatPct(pct(g.approved,totalApproved))
];
}

if(sec.id==="ipdOpdSummary"){
return[
...base,
formatCurrency(g.outstanding),
formatCurrency(aggACS(g)),
formatPct(pct(g.approved,totalApproved))
];
}

if(sec.id==="claimTypeSummary"||sec.id==="diseaseCategory"){
return[
...base,
formatCurrency(g.deduction),
formatCurrency(aggACS(g)),
formatPct(pct(g.approved,totalApproved))
];
}

return[
...base,
formatCurrency(aggACS(g)),
