doc.setFontSize(14);
doc.setTextColor(151,40,29);
doc.text(sec.title,40,50);

if(type==="graph"){
const canvas=document.getElementById(sec.id+"_chart");

if(canvas){
try{
const img=canvas.toDataURL("image/jpeg",0.85);
doc.addImage(img,"JPEG",40,70,pageWidth-80,pageHeight-115);
}catch(e){
doc.setFontSize(11);
doc.setTextColor(0,0,0);
doc.text("Chart image not available.",40,80);
}
}else{
doc.setFontSize(11);
doc.setTextColor(0,0,0);
doc.text("Chart image not available.",40,80);
}

}else{
doc.setFontSize(9);
doc.setTextColor(0,0,0);

let y=75;
const headers=summary.headers||[];
const rows=summary.rows||[];

doc.text(headers.join(" | "),40,y);
y+=16;

rows.forEach(row=>{
if(y>pageHeight-40){
doc.addPage();
y=40;
}
let line=row.map(c=>String(c)).join(" | ");
if(line.length>155)line=line.slice(0,155)+"...";
doc.text(line,40,y);
y+=14;
});
}
});

doc.save(type==="graph"?"IL_Quantum_Graph_Export.pdf":"IL_Quantum_Table_Export.pdf");
showToast(type==="graph"?"PDF Graph exported":"PDF Table exported","success");
}

