}

function cvDemoText(row,aliases,fallback){
const col=cvDemoFindColumn(aliases);
return cvRowText(row,col,fallback||"Unknown");
}

function cvDemoGroup(data,aliases,limit,sortNumeric){
const col=cvDemoFindColumn(aliases);
if(!col)return[];

const map={};
(data||[]).forEach(row=>{
const label=cvRowText(row,col,"Unknown");
map[label]=(map[label]||0)+1;
});

let rows=Object.keys(map).map(label=>({label,value:map[label]}));
rows.sort((a,b)=>sortNumeric?(b.value-a.value):a.label.localeCompare(b.label));
if(limit)rows=rows.slice(0,limit);
return rows;
}

function cvDemoAggregateMoney(data,aliases){
return (data||[]).reduce((sum,row)=>sum+cvDemoNumber(row,aliases),0);
}

function cvDemoDistinct(data,aliases){
const col=cvDemoFindColumn(aliases);
if(!col)return 0;
return new Set((data||[]).map(row=>cvRowText(row,col,"")).filter(Boolean)).size;
}

function cvDemoClaimRows(data){
