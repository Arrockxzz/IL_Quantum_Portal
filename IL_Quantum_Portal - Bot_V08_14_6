<script>
// =====================================================
// BLOCK 102 START - JavaScript Logic
// Purpose: Move module-opened message beside Excel icon and hide after 5 seconds.
// =====================================================
(function(){
"use strict";

let ilqMenuStatusTimer=null;

function ilqDecodeModuleText(value){
return String(value||"")
.replace(/&gt;/g,">")
.replace(/&#62;/g,">")
.replace(/\s*>\s*/g," > ")
.trim();
}

function ilqIsVisible(element){
if(!element)return false;

const style=window.getComputedStyle(element);

return style.display!=="none" &&
style.visibility!=="hidden" &&
style.opacity!=="0" &&
element.offsetWidth>0 &&
element.offsetHeight>0;
}

function ilqEnsureMenuModuleStatus(){
const buttonRow=document.querySelector("#dashboardApp .button-row");
if(!buttonRow)return null;

let status=document.getElementById("ilqMenuModuleStatus");

if(!status){
status=document.createElement("span");
status.id="ilqMenuModuleStatus";
status.setAttribute("aria-live","polite");
status.textContent="";
buttonRow.appendChild(status);
}

return status;
}

function ilqGetStatusAnchor(){
const preUploadMenu=document.getElementById("modulePreUploadMenu");
const actionMenu=document.getElementById("moduleActionMenu");
const dashboardHomeMenu=document.getElementById("dashboardHomeMenu");

/* Prefer Excel icon area. Before upload this is modulePreUploadMenu.
   After upload this is moduleActionMenu. Fallback is dashboard menu icon. */
if(ilqIsVisible(preUploadMenu))return preUploadMenu;
if(ilqIsVisible(actionMenu))return actionMenu;
if(ilqIsVisible(dashboardHomeMenu))return dashboardHomeMenu;

return null;
}

function ilqPositionMenuModuleStatus(){
const status=ilqEnsureMenuModuleStatus();
const buttonRow=document.querySelector("#dashboardApp .button-row");
const anchor=ilqGetStatusAnchor();

if(!status||!buttonRow||!anchor)return;

const buttonRowRect=buttonRow.getBoundingClientRect();
const anchorRect=anchor.getBoundingClientRect();

let leftValue=(anchorRect.right-buttonRowRect.left)+10;
let availableWidth=buttonRowRect.width-leftValue-58;

if(availableWidth<120){
leftValue=Math.max(0,(anchorRect.left-buttonRowRect.left)-270);
availableWidth=260;
}

status.style.setProperty("left",leftValue+"px","important");
status.style.setProperty("right","auto","important");
status.style.setProperty("max-width",Math.max(120,Math.min(360,availableWidth))+"px","important");
}

function ilqSetMenuModuleStatus(message){
const status=ilqEnsureMenuModuleStatus();
if(!status)return;

const cleanMessage=ilqDecodeModuleText(message);

status.textContent=cleanMessage;
ilqPositionMenuModuleStatus();

status.classList.remove("ilq-menu-status-in");
status.classList.remove("ilq-menu-status-visible");

/* Restart small entry animation */
void status.offsetWidth;

status.classList.add("ilq-menu-status-visible");
status.classList.add("ilq-menu-status-in");

if(ilqMenuStatusTimer){
clearTimeout(ilqMenuStatusTimer);
}

ilqMenuStatusTimer=setTimeout(function(){
status.classList.remove("ilq-menu-status-visible");
status.classList.remove("ilq-menu-status-in");

setTimeout(function(){
if(!status.classList.contains("ilq-menu-status-visible")){
status.textContent="";
}
},260);
},5000);
}

window.ilqSetMenuModuleStatus=ilqSetMenuModuleStatus;
window.ilqPositionMenuModuleStatus=ilqPositionMenuModuleStatus;

/*
Intercept only the module-opened success message.
Other toast messages like upload errors, duplicate files, warnings, etc. will continue normally.
*/
setTimeout(function(){
if(typeof window.showToast==="function" && !window.showToast.__ilqMenuStatusWrappedV2){
const originalShowToast=window.showToast;

window.showToast=function(message,type){
const cleanMessage=ilqDecodeModuleText(message);

if(type==="success" && /module opened$/i.test(cleanMessage)){
ilqSetMenuModuleStatus(cleanMessage);
return;
}

return originalShowToast.apply(this,arguments);
};

window.showToast.__ilqMenuStatusWrappedV2=true;
}
},0);

/* Keep status aligned if the screen size or menu state changes */
window.addEventListener("resize",function(){
setTimeout(ilqPositionMenuModuleStatus,0);
});

document.addEventListener("DOMContentLoaded",function(){
ilqEnsureMenuModuleStatus();
setTimeout(ilqPositionMenuModuleStatus,120);
});

})();
// =====================================================
// BLOCK 102 END - JavaScript Logic
// =====================================================
</script>
