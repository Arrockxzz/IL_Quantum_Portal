<script>
// =====================================================
// BLOCK 117 START - JavaScript Logic
// Purpose:
// 1. Stop laggy chart scroll motion from earlier experimental block.
// 2. Keep menu and slicer freeze stable.
// 3. Add file popup processing spinner.
// 4. Rebuild BOT click behavior and auto-close bot after timeout.
// =====================================================
(function(){
"use strict";

const CV117_BOT_TIMEOUT_MS=60000;
let cv117BotTimer=null;
let cv117FilePopupAnimationTimer=null;

/* ---------- Disable experimental scroll-linked chart motion ---------- */
function cv117DisableScrollMotion(){
    try{
        window.cv113InitChartMotion=function(){};
        document.querySelectorAll("#dashboardApp .cv113-scroll-active").forEach(function(node){
            node.classList.remove("cv113-scroll-active");
        });
        document.querySelectorAll("#dashboardApp .claims-demo-card,#dashboardApp .claims-volume-card,#dashboardApp .section-card").forEach(function(card){
            card.style.removeProperty("--cv113-scroll-shift");
            card.style.removeProperty("--cv113-canvas-shift");
            card.style.removeProperty("--cv113-scroll-scale");
            card.style.transform="";
        });
    }catch(error){}
}

/* ---------- File popup spinner + animation ---------- */
function cv117SyncFilePopupState(){
    const dropdown=document.getElementById("fileDropdown");
    if(!dropdown)return;

    const processing=(typeof isProcessing!=="undefined" && isProcessing) ||
        (typeof uploadedFiles!=="undefined" && Array.isArray(uploadedFiles) && uploadedFiles.some(function(file){
            return file && (file.status==="Queued" || file.status==="Processing");
        }));

    dropdown.classList.toggle("cv117-processing",!!processing);

    if(dropdown.classList.contains("active")){
        dropdown.classList.remove("cv117-popup-open");
        void dropdown.offsetWidth;
        dropdown.classList.add("cv117-popup-open");
        clearTimeout(cv117FilePopupAnimationTimer);
        cv117FilePopupAnimationTimer=setTimeout(function(){
            dropdown.classList.remove("cv117-popup-open");
        },360);
    }
}

const cv117PreviousUpdateFilePanel=typeof updateFilePanel==="function" ? updateFilePanel : null;
if(cv117PreviousUpdateFilePanel && !window.__cv117UpdateFilePanelWrapped){
    window.__cv117UpdateFilePanelWrapped=true;
    updateFilePanel=function(){
        const result=cv117PreviousUpdateFilePanel.apply(this,arguments);
        cv117SyncFilePopupState();
        return result;
    };
    window.updateFilePanel=updateFilePanel;
}

const cv117PreviousToggleFilePanel=typeof toggleFilePanel==="function" ? toggleFilePanel : null;
if(cv117PreviousToggleFilePanel && !window.__cv117ToggleFilePanelWrapped){
    window.__cv117ToggleFilePanelWrapped=true;
    toggleFilePanel=function(){
        const result=cv117PreviousToggleFilePanel.apply(this,arguments);
        cv117SyncFilePopupState();
        return result;
    };
    window.toggleFilePanel=toggleFilePanel;
}

/* ---------- BOT reliable open/close ---------- */
function cv117DashboardVisible(){
    const dash=document.getElementById("dashboardApp");
    return !!dash && window.getComputedStyle(dash).display!=="none";
}

function cv117GetBotPanel(){
    return document.getElementById("ilQuantumAISafePanel");
}

function cv117GetBotButton(){
    return document.getElementById("ilQuantumAISafeButton");
}

function cv117RefreshBotSelection(){
    try{
        if(window.ILQuantumAISafe && typeof window.ILQuantumAISafe.refresh==="function"){
            window.ILQuantumAISafe.refresh();
            return;
        }
    }catch(error){}
}

function cv117ClearBotTimer(){
    if(cv117BotTimer){
        clearTimeout(cv117BotTimer);
        cv117BotTimer=null;
    }
}

function cv117StartBotTimer(){
    cv117ClearBotTimer();
    cv117BotTimer=setTimeout(function(){
        cv117CloseBot();
    },CV117_BOT_TIMEOUT_MS);
}

function cv117OpenBot(){
    const panel=cv117GetBotPanel();
    const button=cv117GetBotButton();
    if(!panel || !button || !cv117DashboardVisible())return;

    cv117RefreshBotSelection();

    panel.classList.add("active");
    panel.classList.add("cv117-bot-open");
    panel.style.display="flex";
    panel.style.visibility="visible";
    panel.style.opacity="1";
    panel.style.pointerEvents="auto";
    panel.style.zIndex="72010";

    button.style.display="flex";
    button.style.pointerEvents="auto";
    button.style.zIndex="72000";

    cv117StartBotTimer();
}

function cv117CloseBot(){
    const panel=cv117GetBotPanel();
    if(!panel)return;
    panel.classList.remove("active");
    panel.classList.remove("cv117-bot-open");
    panel.style.display="none";
    cv117ClearBotTimer();
}

function cv117ToggleBot(){
    const panel=cv117GetBotPanel();
    if(!panel)return;
    if(panel.classList.contains("active") || panel.classList.contains("cv117-bot-open")){
        cv117CloseBot();
    }else{
        cv117OpenBot();
    }
}

function cv117InstallBotFix(){
    const button=cv117GetBotButton();
    const panel=cv117GetBotPanel();
    if(!button || !panel)return;

    button.style.pointerEvents="auto";
    button.style.zIndex="72000";

    if(!button.__cv117BotFixed){
        button.__cv117BotFixed=true;
        button.onclick=function(event){
            if(event){
                event.preventDefault();
                event.stopPropagation();
            }
            cv117ToggleBot();
            return false;
        };
        button.addEventListener("click",function(event){
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();
            cv117ToggleBot();
        },true);
    }

    const close=document.getElementById("ilQuantumAISafeClose");
    if(close && !close.__cv117CloseFixed){
        close.__cv117CloseFixed=true;
        close.onclick=function(event){
            if(event){
                event.preventDefault();
                event.stopPropagation();
            }
            cv117CloseBot();
            return false;
        };
    }

    panel.addEventListener("mousemove",cv117StartBotTimer,{passive:true});
    panel.addEventListener("keydown",cv117StartBotTimer,true);
    panel.addEventListener("click",cv117StartBotTimer,true);
}

/* ---------- Sticky menu/slicer sync ---------- */
function cv117SyncStickyOffsets(){
    const controls=document.querySelector("#dashboardApp .controls-card");
    const filters=document.querySelector("#dashboardApp .filters-area");
    if(!controls || !filters)return;
    const h=Math.max(58,Math.ceil(controls.getBoundingClientRect().height||66));
    filters.style.top=h+"px";
}

function cv117Init(){
    cv117DisableScrollMotion();
    cv117SyncFilePopupState();
    cv117InstallBotFix();
    cv117SyncStickyOffsets();
}

cv117Init();
setTimeout(cv117Init,100);
setTimeout(cv117Init,400);
setTimeout(cv117Init,1200);

window.addEventListener("resize",cv117SyncStickyOffsets,{passive:true});
window.addEventListener("scroll",cv117DisableScrollMotion,{passive:true});

document.addEventListener("click",function(event){
    if(event.target.closest("#ilQuantumAISafeButton")){
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        cv117ToggleBot();
        return false;
    }
    if(event.target.closest("[onclick*='toggleFilePanel'],[data-file-toggle='true']")){
        setTimeout(cv117SyncFilePopupState,0);
    }
},true);

const dashboard=document.getElementById("dashboardApp");
if(dashboard){
    new MutationObserver(function(){
        window.requestAnimationFrame(cv117Init);
    }).observe(dashboard,{childList:true,subtree:true,attributes:true,attributeFilter:["class","style"]});
}

window.cv117OpenBot=cv117OpenBot;
window.cv117CloseBot=cv117CloseBot;
window.cv117ToggleBot=cv117ToggleBot;
window.cv117Init=cv117Init;

})();
// =====================================================
// BLOCK 117 END - JavaScript Logic
// =====================================================
</script>
