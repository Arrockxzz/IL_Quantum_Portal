function runStableProcessingProgress(rows,callback){
/*
Keep upload completion fast and avoid repeated synchronous file-panel rebuilds.
Do not call updateFilePanel() directly here because Excel parsing may already be heavy.
*/
updateProgress(100);

if(currentFileMeta){
currentFileMeta.status="Uploaded";
currentFileMeta.progress=100;
scheduleFilePanelUpdate();
}

const continueQueue=()=>{
if(callback)callback();
};

/*
Important:
Use requestAnimationFrame/setTimeout instead of queueMicrotask.
This allows browser to paint progress/file-panel updates before final dashboard render starts.
*/
if(typeof requestAnimationFrame==="function"){
requestAnimationFrame(()=>setTimeout(continueQueue,0));
}else{
setTimeout(continueQueue,0);
}
}

function updateProgress(p){
if(percent)percent.innerText=p+"%";
if(progress)progress.style.width=p+"%";

if(currentFileMeta){
currentFileMeta.progress=p;

/* Avoid rebuilding uploaded-file panel on every FileReader progress tick */
scheduleFilePanelUpdate();
}
}

function fallbackCSVParse(text){
const lines=text.split(/\r?\n/).filter(Boolean);
if(!lines.length)return[];

const headers=lines[0].split(",").map(h=>h.trim());

return lines.slice(1).map(line=>{
const values=line.split(",");
let obj={};
headers.forEach((h,i)=>obj[h]=values[i]||"");
return obj;
});
}

