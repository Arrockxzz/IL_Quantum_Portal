<script>
// =====================================================
// BLOCK 106 START - JavaScript Logic
// Purpose:
// Restore permanent quantum animation, format title,
// remove upper Refresh button, and protect slicer stacking.
// =====================================================
(function(){
"use strict";

/* -----------------------------------------------------
PERMANENT QUANTUM ELEMENT
----------------------------------------------------- */

function cv106RestoreQuantumElement(){

    const dashboardApp=
        document.getElementById(
            "dashboardApp"
        );

    const controls=
        dashboardApp
        ? dashboardApp.querySelector(
            ".controls-card"
        )
        : null;

    if(
        !dashboardApp ||
        !controls
    ){
        return;
    }

    let quantum=
        controls.querySelector(
            ".fq-dashboard-quantum"
        );

    /*
    If another render operation removes the element,
    recreate the original moving quantum structure.
    */
    if(!quantum){

        quantum=
            document.createElement("div");

        quantum.className=
            "fq-dashboard-quantum";

        quantum.setAttribute(
            "aria-hidden",
            "true"
        );

        quantum.innerHTML=
            "<span class='fq-dq-ring fq-dq-r1'></span>" +
            "<span class='fq-dq-ring fq-dq-r2'></span>" +
            "<span class='fq-dq-core'></span>" +
            "<span class='fq-dq-particle fq-dq-p1'></span>" +
            "<span class='fq-dq-particle fq-dq-p2'></span>" +
            "<span class='fq-dq-particle fq-dq-p3'></span>";

        controls.insertBefore(
            quantum,
            controls.firstChild
        );
    }

    quantum.style.display="block";
    quantum.style.visibility="visible";
    quantum.style.opacity="1";

    quantum.querySelectorAll(
        ".fq-dq-core," +
        ".fq-dq-ring," +
        ".fq-dq-particle"
    ).forEach(function(element){

        element.style.display="block";
        element.style.visibility="visible";
        element.style.opacity="1";
        element.style.animationPlayState=
            "running";
    });
}

/* -----------------------------------------------------
GHI CLAMS VOLUME TITLE
----------------------------------------------------- */

function cv106FormatClaimsVolumeTitle(){

    const dashboardApp=
        document.getElementById(
            "dashboardApp"
        );

    if(
        !dashboardApp ||
        !dashboardApp.classList.contains(
            "claims-volume-layout-active"
        )
    ){
        return;
    }

    const heading=
        dashboardApp.querySelector(
            ".claims-demo-heading"
        );

    if(!heading){
        return;
    }

    const eyebrow=
        heading.querySelector(
            ".claims-demo-eyebrow"
        );

    if(eyebrow){

        eyebrow.innerHTML=
            "<span class='claims-demo-live-dot'></span>" +
            "<span class='cv106-title-text'>" +
                "GHI Clams Volume" +
            "</span>";
    }

    /* Remove duplicate or old upper content */
    const oldTitle=
        heading.querySelector("h2");

    if(oldTitle){
        oldTitle.remove();
    }

    const oldDescription=
        heading.querySelector("p");

    if(oldDescription){
        oldDescription.remove();
    }

    const oldStatus=
        heading.querySelector(
            ".claims-demo-status-chip"
        );

    if(oldStatus){
        oldStatus.remove();
    }

    /* Remove only the Refresh button above the KPIs */
    heading.querySelectorAll(
        ".claims-demo-reset"
    ).forEach(function(button){
        button.remove();
    });

    const actionArea=
        heading.querySelector(
            ".claims-demo-head-actions"
        );

    if(
        actionArea &&
        !actionArea.children.length
    ){
        actionArea.remove();
    }
}

/* -----------------------------------------------------
SLICER STACKING
----------------------------------------------------- */

function cv106PrepareSlicers(){

    document.querySelectorAll(
        "#dashboardApp .filter-menu"
    ).forEach(function(menu){

        menu.style.zIndex="50000";

        const pill=
            menu.closest(
                ".filter-pill"
            );

        if(!pill){
            return;
        }

        if(
            menu.classList.contains(
                "active"
            )
        ){
            pill.style.zIndex="45000";
        }else{
            pill.style.zIndex="";
        }
    });
}

/* Apply all UI corrections */
function cv106ApplyPermanentUI(){

    cv106RestoreQuantumElement();
    cv106FormatClaimsVolumeTitle();
    cv106PrepareSlicers();
}

/* Initial application */
setTimeout(
    cv106ApplyPermanentUI,
    80
);

/*
Observe dashboard rebuilding after:
- Excel upload
- Live/Demo switch
- module movement
- filter changes
- refresh
*/
const cv106DashboardApp=
    document.getElementById(
        "dashboardApp"
    );

if(cv106DashboardApp){

    const cv106Observer=
        new MutationObserver(function(){

            window.requestAnimationFrame(
                cv106ApplyPermanentUI
            );
        });

    cv106Observer.observe(
        cv106DashboardApp,
        {
            childList:true,
            subtree:true
        }
    );
}

/*
Capture slicer opening and place the active slicer
above all charts immediately.
*/
document.addEventListener(
    "click",
    function(event){

        const filterButton=
            event.target.closest(
                "#dashboardApp .filter-btn"
            );

        if(filterButton){

            setTimeout(
                cv106PrepareSlicers,
                0
            );

            return;
        }

        const insideMenu=
            event.target.closest(
                "#dashboardApp .filter-menu"
            );

        if(insideMenu){

            setTimeout(
                cv106PrepareSlicers,
                0
            );
        }
    },
    true
);

/*
Ensure animation remains active after the browser tab
or dashboard becomes visible again.
*/
document.addEventListener(
    "visibilitychange",
    function(){

        if(!document.hidden){
            cv106RestoreQuantumElement();
        }
    }
);

// =====================================================
// BLOCK 106 END - JavaScript Logic
// =====================================================
})();
</script>

